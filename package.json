{
  "name": "pi-taskbus",
  "version": "0.1.0",
  "description": "Checkpoint-driven task trees and enforced tool attribution for Pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "tasks"
  ],
  "license": "MIT",
  "author": "Moonhalf383",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moonhalf383/pi-taskbus.git"
  },
  "homepage": "https://github.com/Moonhalf383/pi-taskbus#readme",
  "bugs": {
    "url": "https://github.com/Moonhalf383/pi-taskbus/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "assets/taskbus.png",
    "taskbus.example.json"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "validate": "npm run check && npm test",
    "test:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run validate && npm run test:package"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  }
}

{
  "name": "pi-taskbus",
  "version": "0.1.0",
  "description": "Checkpoint-driven task trees and enforced tool attribution for Pi",
  "type": "module",
  "keywords": ["pi-package", "pi", "tasks"],
  "license": "MIT",
  "files": ["src", "README.md", "taskbus.example.json"],
  "pi": { "extensions": ["./src/index.ts"] },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "validate": "npm run check && npm test"
  },
  "engines": { "node": ">=22" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  }
}
